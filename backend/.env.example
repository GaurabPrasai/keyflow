# Local development: copy to backend/.env
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local frontend origin (CORS and CSRF checks)
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty locally to use SQLite
DATABASE_URL=

# Production (Azure App Service) values
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=keyflow-api.azurewebsites.net
# FRONTEND_URL=https://keyflow-bay.vercel.app
# CSRF_TRUSTED_ORIGINS=https://keyflow-api.azurewebsites.net,https://keyflow-bay.vercel.app
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
